<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlixFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: #0d0d1a; border-bottom: 2px solid #e50914;">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-film text-danger me-2"></i>FlixFlow
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Popular">Popular</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">Browse All</a>
                        </li>
                    </ul>
                    <form class="d-flex me-3" asp-controller="Movies" asp-action="Search" method="get">
                        <input class="form-control me-2" type="search" name="query" placeholder="Search movies..." aria-label="Search">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" style="background: #1a1a2e; border: 1px solid #2a2a3e;">
                                    <li>
                                        <a class="dropdown-item text-white" asp-controller="Watchlist" asp-action="Index">
                                            <i class="fas fa-heart text-danger"></i> My Watchlist
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-white" asp-controller="Favorites" asp-action="Index">
                                            <i class="fas fa-star text-warning"></i> My Favorites
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-white" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-user text-danger"></i> Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" style="border-color: #2a2a3e;"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-white" style="background: none; border: none; width: 100%; text-align: left;">
                                                <i class="fas fa-sign-out-alt text-danger"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-danger text-white px-3 ms-2" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="background: #0d0d1a; min-height: 100vh; padding-bottom: 60px;">
        @RenderBody()
    </main>

    <footer class="footer text-center text-muted py-3" style="background: #0d0d1a; border-top: 1px solid #2a2a3e;">
        <div class="container">
            <i class="fas fa-film text-danger me-2"></i>
            &copy; @DateTime.Now.Year - FlixFlow - Your cinematic treasure chest
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>