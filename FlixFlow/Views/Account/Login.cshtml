@model FlixFlow.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg" style="background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 12px;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-film text-danger" style="font-size: 3rem;"></i>
                        <h2 class="text-white mt-3">Welcome Back</h2>
                        <p class="text-muted">Sign in to your FlixFlow account</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-white"></label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-white"></label>
                            <input asp-for="Password" class="form-control" placeholder="Your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-white"></label>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fs-5">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </button>
                    </form>

                    <hr style="border-color: #2a2a3e;" />

                    <p class="text-center text-muted mb-0">
                        Don't have an account?
                        <a asp-action="Register" class="text-danger text-decoration-none fw-bold">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
