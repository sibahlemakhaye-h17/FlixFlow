@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg mx-auto" style="background: #1a1a2e; border: 1px solid #2a2a3e; max-width: 500px;">
        <div class="card-body p-5">
            <i class="fas fa-lock text-danger" style="font-size: 4rem;"></i>
            <h2 class="text-white mt-4">Access Denied</h2>
            <p class="text-muted">You don't have permission to access this page.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">
                <i class="fas fa-home me-2"></i>Go Home
            </a>
        </div>
    </div>
</div>
